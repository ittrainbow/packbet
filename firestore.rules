rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function storedAdmin() {
      return ('admin' in resource.data) ? resource.data.admin : false;
    }

    function isUserProfile(data) {
      return data.keys().hasOnly(['name', 'locale', 'buddies', 'admin'])
        && data.name is string
        && data.locale in ['ru', 'ua', 'by']
        && data.buddies is list
        && data.admin is bool;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId)
        && isUserProfile(request.resource.data)
        && request.resource.data.admin == false;
      allow update: if isOwner(userId)
        && isUserProfile(request.resource.data)
        && request.resource.data.admin == storedAdmin();
      allow delete: if false;
    }

    match /answers/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    match /weeks/{weekId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /results/{weekId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /standings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /about/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
