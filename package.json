{
  "name": "pack-contest",
  "version": "2.0.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "dependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@reduxjs/toolkit": "^1.9.5",
    "@types/node": "^20.4.8",
    "@types/react": "^18.2.18",
    "@types/react-dom": "^18.2.7",
    "@types/react-router-dom": "^5.3.3",
    "clsx": "^2.1.1",
    "firebase": "^10.13.0",
    "history": "^5.3.0",
    "moment": "^2.29.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-firebase-hooks": "^5.1.1",
    "react-redux": "^8.1.2",
    "react-router-dom": "6",
    "react-scripts": "5.0.1",
    "react-toastify": "^9.1.3",
    "redux": "^4.2.1",
    "redux-first-history": "^5.1.1",
    "redux-saga": "^1.2.3",
    "typescript": "^5.1.6",
    "zod": "^3.23.8"
  },
  "scripts": {
    "start": "craco start",
    "build": "craco build",
    "test": "craco test",
    "eject": "react-scripts eject",
    "lint": "tsc --noEmit && eslint \"src/**/*.{ts,tsx}\""
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ],
    "ignorePatterns": [
      "build/",
      "node_modules/",
      "coverage/"
    ],
    "rules": {
      "import/no-anonymous-default-export": [
        "error",
        {
          "allowArrowFunction": true
        }
      ],
      "no-multiple-empty-lines": [
        "error",
        {
          "max": 1
        }
      ],
      "no-trailing-spaces": 0,
      "no-unused-vars": 1,
      "semi": 0
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@craco/craco": "^7.1.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0"
  }
}
